# ============================================================================
# Desanatization — environment configuration (example)
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# On Railway (or any host) set these as real environment variables instead;
# the file is only read for local development and is git-ignored.
# ============================================================================

# --- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Set to false when running behind a plain (non-proxy) load balancer.
TRUST_PROXY=true

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# Use * to allow any origin (development only).
ALLOWED_ORIGINS=*

# --- REQUIRED: where your money goes ---------------------------------------
# Your EVM wallet address (42 chars, starts with 0x). USDC settles here.
# The value below is the x402 documentation DEMO address — replace it, or you
# will be paying someone else.
PAY_TO_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f42b15

# --- Payment: what and how much --------------------------------------------
# Network as a CAIP-2 identifier:
#   eip155:84532  Base Sepolia  (testnet, no real money)
#   eip155:8453   Base          (mainnet, real USDC)
NETWORK=eip155:84532

# Price per request. A dollar string ("$0.001") is resolved to the network's
# default stablecoin (USDC). For another token, pass JSON:
#   PRICE={"asset":"0x<token>","amount":"1000"}
PRICE=$0.001

# How long a buyer's signed authorisation stays valid, in seconds.
PAYMENT_TIMEOUT_SECONDS=300

# --- Facilitator: who verifies and settles payments -------------------------
# https://x402.org/facilitator is the public TESTNET facilitator (no API key,
# Base Sepolia + Solana devnet only). For real money on Base mainnet use a
# production facilitator — see docs/x402 guides — e.g. Coinbase CDP or PayAI,
# and set FACILITATOR_AUTH_HEADER if that provider requires one.
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_TIMEOUT_MS=20000
# Optional. Sent as `Authorization` on verify/settle/supported calls.
# FACILITATOR_AUTH_HEADER=Bearer <your-facilitator-api-key>

# --- Protected resource ----------------------------------------------------
RESOURCE_PATH=/api/resource
RESOURCE_DESCRIPTION=PII sanitization for AI agents
RESOURCE_MIME_TYPE=application/json
SERVICE_NAME=Desanatization

# --- Startup behaviour -----------------------------------------------------
# Verify the facilitator at boot and mark the service not-ready if it fails.
SYNC_FACILITATOR_ON_START=true
# When true, exit at boot if the facilitator preflight fails, so the deploy
# fails loudly instead of serving requests that can never be paid.
# Defaults to true when NODE_ENV=production.
STRICT_STARTUP=false

# --- Abuse protection ------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Observability ---------------------------------------------------------
# Optional bearer token for GET /api/metrics. Unset = endpoint is public.
# METRICS_TOKEN=change-me

# --- Outbound growth engine --------------------------------------------------
# The growth engine discovers and pitches peer x402 agents (growth.js). It fires
# a cycle at boot, then on the interval. Capped per cycle so it can never become
# a spam cannon. Enabled by default in production; defaults to false elsewhere.
# GROWTH_ENABLED=false
# Peers to pitch, shell-safe format: "https://a|kind, https://b" or JSON array
# [{"url":"https://a","kind":"manual"}] (note: some hosts strip double quotes
# from variable values — the pipe format is immune).
# GROWTH_TARGETS=https://peer1.example|manual
# Optional registry feed (JSON array of URLs) merged into the pool each cycle.
# Defaults to the CDP x402 Bazaar discovery endpoint.
# GROWTH_DISCOVERY_URL=
# Our public base URL, embedded in the pitch we leave for peers. Auto-detected
# from RAILWAY_STATIC_URL on Railway. Set explicitly for other hosts.
# GROWTH_PUBLIC_URL=https://desanatization-production.up.railway.app
# Cycle cadence and per-cycle pitch cap.
# GROWTH_INTERVAL_MS=21600000
# GROWTH_MAX_PER_CYCLE=5
# Where the learned ledger lives across restarts (a mounted volume).
# GROWTH_STATE_PATH=/app/data/growth-state.json
# Where the task agent's skill library lives across restarts.
# GROWTH_AGENT_STATE_PATH=/app/data/agent-state.json

# Expanded B2B outreach: scan GitHub repos, Google Cloud Agent Gallery, and
# Salesforce AgentExchange for new x402/crypto/AI-agent peers on every cycle.
# GROWTH_DISCOVER_FROM_ALL=true
# Optional GitHub token for higher API rate limits.
# GITHUB_TOKEN=

# --- Outbound notifications (opt-in) ---------------------------------------
# Fires durable, operator-facing events: the first successful purchase
# (exactly once), every settlement, and periodic insights. Dependency-free —
# every transport is plain HTTP, so no SMTP library is needed.
# NOTIFICATION_TRANSPORT=none      # none | webhook | smtp
# Webhook: POST a JSON event envelope to this URL.
# NOTIFICATION_WEBHOOK_URL=https://your-hook.example/notify
# SMTP: POST a JSON email envelope to an HTTP-to-email bridge (SendGrid v3,
# Mailgun, Resend, or your own). Requires FROM and TO.
# NOTIFICATION_SMTP_URL=https://api.example.com/v3/mail/send
# NOTIFICATION_FROM=you@example.com
# NOTIFICATION_TO=owner@example.com
# Where the first-purchase milestone is persisted so restarts do not re-alert.
# NOTIFICATION_STATE_PATH=/app/data/notification-state.json
