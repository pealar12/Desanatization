{
  "name": "desanatization-server",
  "version": "1.6.0",
  "description": "Production-ready x402 (v2) payment-gated API server for AI agents.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "NODE_ENV=test node --test 'test/**/*.js'",
    "test:watch": "NODE_ENV=test node --test --watch 'test/**/*.js'",
    "client": "node clients/fetch-client.mjs",
    "log:review": "node scripts/log-review.mjs",
    "log:live": "node scripts/log-review.mjs --live",
    "preflight": "node scripts/preflight.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "keywords": [
    "x402",
    "payments",
    "usdc",
    "base",
    "agents",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "@x402/core": "~2.26.0",
    "@x402/evm": "~2.26.0",
    "@x402/express": "~2.26.0",
    "@x402/extensions": "~2.26.0",
    "@x402/fetch": "~2.26.0",
    "express": "^4.21.2",
    "viem": "^2.56.5"
  }
}
